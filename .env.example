# ===== LLM providers (fill what you use) =====
# Dev (free tier): https://aistudio.google.com -> Get API key
GEMINI_API_KEY=
# Final evals (paid, needed by Day 5): https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# Which provider/model the app uses: gemini | anthropic | ollama
LLM_PROVIDER=gemini
# Leave blank: Claude fills these with verified model IDs when wiring up the LLM layer (Day 2)
LLM_MODEL=
LLM_MODEL_LARGE=

# Optional: local small-model baseline (Ollama)
OLLAMA_BASE_URL=http://localhost:11434

# ===== Database (local Docker Postgres; defaults are fine) =====
POSTGRES_USER=loan
POSTGRES_PASSWORD=loan_dev_pw
POSTGRES_DB=loan_intake
DATABASE_URL=postgresql://loan:loan_dev_pw@localhost:5433/loan_intake

# ===== App =====
API_PORT=8000

# --- Deployment (set these as secrets/env vars on the host; never commit real values) ---
# Managed Postgres connection string (Aiven/Neon/Fly). Needs ?sslmode=require for most hosts.
# DATABASE_URL=postgres://user:password@host:port/dbname?sslmode=require
# Comma-separated UI origins allowed to call the API (your Vercel URL, no trailing slash)
# CORS_ORIGINS=https://your-app.vercel.app
# Where uploaded PDFs are stored (mount a persistent volume here in production)
# UPLOADS_DIR=/data/uploads
